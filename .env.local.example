# Browser-safe RPC configuration
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL_SECONDARY=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL_SECONDARY=
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545

# Optional fully qualified canonical production origin when not deployed on Vercel
SOWMORROW_SITE_URL=

# The defaults describe the Base Sepolia test story, matching SOWMORROW_DEPLOYMENT_CHAIN_ID below.
# Point the browser at the local stack with NEXT_PUBLIC_SOWMORROW_CHAIN_ID=31337 after `npm run
# local:up`; the Convex indexer stays on a public chain because it cannot reach a local node.
# Keep writes disabled until an active reviewed manifest exists for the selected chain.
NEXT_PUBLIC_SOWMORROW_CHAIN_ID=84532
NEXT_PUBLIC_SOWMORROW_WRITES_ENABLED=false
NEXT_PUBLIC_SOWMORROW_MAINNET_RELEASED=false

# Added by `npx convex dev`; do not copy a production value into test runs
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Set these with `npx convex env set`, not as NEXT_PUBLIC values
SOWMORROW_CDP_WEBHOOK_SECRET=
SOWMORROW_DEPLOYMENT_CHAIN_ID=84532
# Gates historical range backfill only; tip promotion, orphaning, and reorg rewind run whenever a
# deployment is configured
SOWMORROW_INDEXER_ENABLED=false
SOWMORROW_BASE_MAINNET_RPC_URL=
SOWMORROW_BASE_SEPOLIA_RPC_URL=
# Optional second provider per chain; safe-head hashes must agree across both before promotion
SOWMORROW_BASE_MAINNET_RPC_URL_SECONDARY=
SOWMORROW_BASE_SEPOLIA_RPC_URL_SECONDARY=
# Pruning window for terminal webhookDeliveries and syncRuns
SOWMORROW_RETENTION_DAYS=30
# Optional discovery start block; defaults to the manifest deploymentBlock
SOWMORROW_B20_FACTORY_START_BLOCK=

# Foundry reads these only in an operator shell
BASE_MAINNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=
SOWMORROW_OWNER=
SOWMORROW_START_PAUSED=true
SOWMORROW_STOCKS=
SOWMORROW_MIN_AMOUNTS_RAW=

# Local stack. `npm run local:up` publishes the pinned base-anvil node here and `npm run
# contracts:test:integration` reuses it. Change the port only if 8545 is already taken.
SOWMORROW_LOCAL_RPC_PORT=8545
