{
  "name": "sowmorrow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.14.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "convex:typecheck": "tsc -p convex/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project node",
    "test:components": "vitest run --project components",
    "test:convex": "vitest run --project convex",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "pretest:e2e:a11y": "npm run build",
    "test:e2e:a11y": "playwright test --grep \"has no automatically detectable accessibility violations\"",
    "format:check": "prettier --check .github app components convex data e2e lib scripts docs README.md contracts/README.md contracts/deployments/*.json contracts/toolchain.lock.json eslint.config.mjs package.json playwright.config.ts tsconfig.json vitest.config.mts wagmi.config.ts",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vvv",
    "contracts:test:native": "./scripts/contracts/test-native.sh",
    "contracts:test:integration": "./scripts/contracts/test-integration.sh",
    "contracts:coverage": "forge coverage --root contracts --match-contract SowmorrowVaultTest",
    "contracts:slither": "./scripts/contracts/run-slither.sh",
    "contracts:echidna": "./scripts/contracts/run-echidna.sh",
    "contracts:generate": "wagmi generate && prettier --write lib/contracts/generated.ts",
    "contracts:check-bindings": "tsx scripts/contracts/check-bindings.ts",
    "contracts:check-catalog": "tsx scripts/contracts/check-catalog.ts",
    "contracts:check-manifests": "tsx scripts/contracts/check-manifests.ts",
    "contracts:check-network": "./scripts/contracts/check-network.sh",
    "contracts:fmt:check": "forge fmt --root contracts --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run convex:typecheck && npm run test && npm run contracts:check-catalog && npm run contracts:check-manifests && npm run contracts:check-bindings && npm run build",
    "verify": "npm run check && npm audit --audit-level=high && npm run test:coverage && npm run test:e2e && npm run contracts:fmt:check && npm run contracts:test && npm run contracts:test:native && npm run contracts:coverage && npm run contracts:slither && npm run contracts:echidna",
    "local:up": "./scripts/local/up.sh",
    "local:down": "./scripts/local/down.sh",
    "verify:release": "npm run verify && npm run contracts:check-network"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "convex": "1.45.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.3",
    "wagmi": "3.7.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@wagmi/cli": "2.10.0",
    "convex-test": "0.0.56",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "happy-dom": "20.13.2",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
